{$APP_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    Permissions-Policy "camera=(self), microphone=()"
    Strict-Transport-Security "max-age=31536000"
  }
  handle /api/* {
    reverse_proxy api:4311
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
