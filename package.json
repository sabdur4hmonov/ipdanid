{
  "name": "ip-rasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config playwright.ci.config.ts",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "check": "npm run build && npm test",
    "server": "tsx server/index.ts",
    "test:sandbox": "node scripts/verify-sandbox.mjs",
    "test:customer:http": "node --import tsx scripts/verify-customer-http.mjs",
    "local": "node scripts/run-local.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/upng": "^1.0.1",
    "bidi-js": "1.0.3",
    "firebase": "12.19.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "poly2tri": "1.5.0",
    "polygon-clipping": "0.15.7",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsqr": "1.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
