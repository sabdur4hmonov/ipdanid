VITE_PRODUCT_NAME=Ip Rasm
# No live providers are configured. Never put merchant secrets in VITE_ variables.
VITE_NATIVE_API_BASE=
# Debug APK only. Release signing script always forces this to0.
VITE_NATIVE_DEBUG_SETTINGS=0
# Server only: production defaults beside DATABASE_PATH; Compose uses a separate
# persistent erasure volume at /privacy/erasure-intents.sqlite. Preserve it on restore.
ERASURE_LEDGER_PATH=
# Payments are disabled unless explicitly running the sandbox. Server-only keys.
PAYMENTS_SANDBOX=0
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_LOGIN=
PAYME_TEST_KEY=
# VPS: scripts/deploy.sh creates private .env.production interactively.
# Do not reuse the development LOCAL_ADMIN_TOKEN in production.
APP_DOMAIN=
ADMIN_PASSWORD_HASH=
CODE_PEPPER=
SANDBOX_PAYMENT_KEY=
# VPS: scripts/deploy.sh creates private .env.production interactively.
# Do not reuse the development LOCAL_ADMIN_TOKEN in production.
APP_DOMAIN=
ADMIN_PASSWORD_HASH=
CODE_PEPPER=
SANDBOX_PAYMENT_KEY=
# Push remains disabled until the owner configures Firebase. Never use mock in production.
# The service-account private key belongs ONLY on the API, never in VITE_* or Git.
FCM_MODE=disabled
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Public Firebase web app configuration and PUBLIC VAPID key (not service-account secrets).
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_SENDER_ID=
FCM_VAPID_PUBLIC_KEY=
# Transactional mail is opt-in per registered account. Server-only secrets.
# disabled (default), resend (real configured provider), mock (isolated tests only).
TRANSACTIONAL_EMAIL_MODE=disabled
TRANSACTIONAL_EMAIL_FROM=
RESEND_API_KEY=
