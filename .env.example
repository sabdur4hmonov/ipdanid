VITE_PRODUCT_NAME=Ip Rasm
# Local development compatibility only. Docker+Compose and owner release builds
# force both protected modes to1; see docs/PROTECTED_GENERATION_UZ.md.
# API only; prepared targets require explicit consent, private jobs expire in30min.
SERVER_GENERATION=0
# Matching local customer build; no local fitter fallback when1. API must also be1.
VITE_SERVER_GENERATION=0
# No live providers are configured. Never put merchant secrets in VITE_ variables.
VITE_NATIVE_API_BASE=
# Debug APK only. Release signing script always forces this to0.
VITE_NATIVE_DEBUG_SETTINGS=0
# Server only: production defaults beside DATABASE_PATH; Compose uses a separate
# persistent erasure volume at /privacy/erasure-intents.sqlite. Preserve it on restore.
ERASURE_LEDGER_PATH=
# Exact immediate proxy IPs only; no wildcard or X-Forwarded-For trust.
# Compose supplies APP_PROXY_IP. Bare Node behind a local proxy: TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=
GALLERY_MAX_ITEMS=10000
GALLERY_MAX_BYTES=268435456
# Change these together only if an existing Docker network overlaps this subnet.
APP_BACKEND_SUBNET=172.30.51.0/24
APP_PROXY_IP=172.30.51.2
APP_API_IP=172.30.51.3
APP_BACKUP_IP=172.30.51.4
# Payments are disabled unless explicitly running the sandbox. Server-only keys.
PAYMENTS_SANDBOX=0
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_LOGIN=
PAYME_TEST_KEY=
# VPS: scripts/deploy.sh creates private .env.production interactively.
# Do not reuse the development LOCAL_ADMIN_TOKEN in production.
APP_DOMAIN=
ADMIN_PASSWORD_HASH=
CODE_PEPPER=
SANDBOX_PAYMENT_KEY=
# Server-only allowlist. Unset in bare development enables historical features;
# production/Compose blank means core only. Exact comma-separated names:
# mosaic,diamond,paint,book,qr,models,workshops,partner,commissions,push,gallery,
# expert,analytics,digital,gifts,offers,inbox,trials,lettering,photoBackup
# FEATURES=expert,gallery
CLASSIC_TUNING=4
# Independent random 32-byte base64url key; keep securely OFF the VM too.
# setup-production-env generates this, never derive it from CODE_PEPPER.
BACKUP_ENCRYPTION_KEY=
# Optional OCI customer-secret-key S3 upload; all five required together.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=iprasm/
# Push remains disabled until the owner configures Firebase. Never use mock in production.
# The service-account private key belongs ONLY on the API, never in VITE_* or Git.
FCM_MODE=disabled
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Public Firebase web app configuration and PUBLIC VAPID key (not service-account secrets).
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_SENDER_ID=
FCM_VAPID_PUBLIC_KEY=
# Transactional mail is opt-in per registered account. Server-only secrets.
# disabled (default), resend (real configured provider), mock (isolated tests only).
TRANSACTIONAL_EMAIL_MODE=disabled
TRANSACTIONAL_EMAIL_FROM=
RESEND_API_KEY=
